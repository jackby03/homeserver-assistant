# Base URL for the daemon API when the UI is served from a different origin.
# Leave empty when the SPA is served by the daemon / behind the Vite dev proxy.
# Example: VITE_API_BASE=https://homeserver.local:8443
VITE_API_BASE=

# Optional explicit WebSocket base (defaults to VITE_API_BASE or the page origin).
# Example: VITE_WS_BASE=wss://homeserver.local:8443
VITE_WS_BASE=

# Shared secret for the loopback kiosk API (normally injected by the kiosk
# launcher). A development override can also be stored in localStorage under
# the key "hs.kioskToken".
VITE_KIOSK_TOKEN=

# Visual demo mode for design review without a backend. Only the kiosk uses
# demo data and it is always labelled "Demo" in the UI.
VITE_DEMO=0
