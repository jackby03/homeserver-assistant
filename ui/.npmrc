# Flat package tree: required to verify builds inside restricted Windows
# sandboxes where symlinked (junctional) package stores are not resolvable by
# the Node ESM loader.
node-linker=hoisted

# Avoid the implicit pre-run install check: in sealed sandboxes it cannot open
# pnpm's store-operation lock and would emit noisy errors before running a
# script. Dependencies are installed explicitly with `pnpm install`.
verify-deps-before-run=false
