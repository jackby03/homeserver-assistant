# Normalize line endings: Linux appliance sources must stay LF.
* text=auto eol=lf

*.rs        text eol=lf
*.toml      text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.json      text eol=lf

# Explicitly mark binary assets.
*.png binary
*.jpg binary
*.webp binary
*.iso binary
*.qcow2 binary
